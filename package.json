{
  "name": "learning-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Learning dsh — versioned bilingual (en/zh) source-code learning page, delivered as a DeepSeek Harness (dsh) plugin",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:content": "tsx scripts/build-content.ts",
    "dev:web": "pnpm --filter @learning-dsh/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
